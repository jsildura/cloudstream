# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Used by the Vite dev server only. Production reads ZXC_STREAM_SECRET from
# Cloudflare's encrypted binding: `wrangler pages secret put ZXC_STREAM_SECRET`

VITE_TMDB_READ_ACCESS_TOKEN=
ZXC_STREAM_SECRET=

# Set to 'true' to connect the dev server to local Firebase Auth (port 9099) and RTDB (port 9000) emulators.
# Must remain 'false' or omitted in production.
VITE_USE_FIREBASE_EMULATORS=false
