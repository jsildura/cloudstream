{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "streamflix-stream",
	"compatibility_date": "2025-11-01",
	"pages_build_output_dir": "./dist",
	"observability": {
		"enabled": true
	},
	// Non-secret config for the Pages Functions in functions/. These same values
	// are already public in the client bundle (see src/lib/firebase.js), so they
	// are plain vars. Everything genuinely secret — AD_KEY_HMAC_SECRET,
	// FIREBASE_SERVICE_ACCOUNT, PAYPAL_CLIENT_SECRET — is an encrypted secret set
	// via the dashboard or `wrangler pages secret put`, never listed here.
	"vars": {
		"FIREBASE_PROJECT_ID": "streamflix-chat",
		"FIREBASE_DATABASE_URL": "https://streamflix-chat-default-rtdb.firebaseio.com",
		"PAYPAL_CLIENT_ID": "BAAtSXXI6ddkYAIITfOlcOBomPT87gyxfbdBDssr73mpKKR-B-5NxNrMA_jq8vv0tsLy6wP_QCUeA4MQA4",
		"PAYPAL_ENV": "live"
	},
	"kv_namespaces": [
		{
			"binding": "VISITOR_STATS",
			"id": "12b87ad5668f4714a4b87829926baf29"
		},
		{
			// Mood-tag cache for /api/ai (see Mood_Tags_AI_implementation_plan.md).
			// Create the namespace in the Cloudflare dashboard (Workers & Pages ->
			// KV) and REPLACE this id — the placeholder only keeps the config valid.
			"binding": "MOOD_TAGS",
			"id": "1f50e39d1298499bb3aded13cfe05689"
		}
	]
}