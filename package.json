{
	"name": "streamflix",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:analyze": "cross-env ANALYZE=true vite build",
		"optimize:images": "node scripts/optimize-images.mjs",
		"lint": "eslint .",
		"preview": "npm run build && wrangler pages dev",
		"preview:pages": "npm run build && wrangler pages dev dist --port 8788",
		"deploy": "npm run build && wrangler pages deploy",
		"deploy:firebase-rules": "firebase deploy --only database --project streamflix-chat",
		"deploy:firebase-rules:transitional": "firebase deploy --only database --project streamflix-chat --config firebase.transitional.json",
		"cf-typegen": "wrangler types",
		"test": "npm run test:unit",
		"test:unit": "vitest run src",
		"test:rules": "node scripts/run-emulator-exec.mjs \"vitest run tests/database --config vitest.rules.config.js\"",
		"test:rules:transitional": "cross-env RULES_FILE=database.rules.transitional.json node scripts/run-emulator-exec.mjs \"vitest run tests/database --config vitest.rules.config.js\"",
		"test:chat": "vitest run src/lib/globalChatIdentity.test.js src/lib/globalChatModel.test.js src/components/GlobalChatSignInWall.test.jsx src/components/GlobalChat.test.js src/components/GlobalChat.integration.test.jsx src/contexts/AuthContext.test.jsx src/components/settings/AccountSettings.test.jsx",
		"verify:chat": "npm run test:chat && npm run test:rules:transitional && npm run test:rules && npm run build",
		"firebase:emulators": "node scripts/run-emulator-exec.mjs",
		"chat:admin": "node scripts/global-chat-admin.mjs",
		"test:admin-script": "vitest run scripts/global-chat-admin.test.js",
		"chat:seed-faq": "node scripts/seed-chat-faq.mjs",
		"test:seed-faq-script": "vitest run scripts/seed-chat-faq.test.js",
		"clean:anon": "node scripts/cleanup-anonymous-users.mjs",
		"test:clean-script": "vitest run scripts/cleanup-anonymous-users.test.js",
		"adfree:generate": "node scripts/generate-adfree-keys.mjs",
		"test:generate-keys-script": "vitest run scripts/generate-adfree-keys.test.js"
	},
	"dependencies": {
		"@ffmpeg/ffmpeg": "^0.12.15",
		"@ffmpeg/util": "^0.12.2",
		"@formspree/react": "^3.0.0",
		"disable-devtool": "^0.3.9",
		"hls.js": "^1.6.16",
		"jszip": "^3.10.1",
		"lucide-react": "^0.562.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^7.9.5",
		"shaka-player": "^4.16.12",
		"vite-plugin-pwa": "^1.2.0",
		"vite-plugin-sitemap": "^0.8.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.33.0",
		"@firebase/rules-unit-testing": "^3.0.4",
		"@qwik.dev/partytown": "^0.14.2",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react": "^5.1.2",
		"beasties": "^0.4.3",
		"cross-env": "^10.1.0",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"firebase": "^10.14.1",
		"firebase-admin": "^14.2.0",
		"firebase-tools": "^13.31.0",
		"globals": "^16.3.0",
		"happy-dom": "^20.11.2",
		"rollup-plugin-visualizer": "^7.1.1",
		"sharp": "^0.35.3",
		"svgo": "^4.1.0",
		"vite": "^7.1.2",
		"vite-plugin-image-optimizer": "^2.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.45.3"
	}
}
